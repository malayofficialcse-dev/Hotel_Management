// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Employee {
  id           String     @id @default(uuid()) @db.Uuid
  employeeCode String?    @unique @map("employee_code") @db.VarChar(64)
  userId       String     @unique @db.Uuid @map("user_id")
  departmentId String     @map("department_id")
  hotelId      String?    @map("hotel_id") @db.VarChar(64)
  name         String     @db.VarChar(128)
  email        String     @db.VarChar(255)
  phone        String?    @db.VarChar(32)
  position     String     @db.VarChar(64)
  joiningDate  DateTime   @db.Date @map("joining_date")
  salary       Float?
  role         String?    @default("STAFF") @db.VarChar(64)
  permissions  Json?
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt    DateTime   @updatedAt @db.Timestamptz(6) @map("updated_at")
  tasks        Task[]
  schedules    Schedule[]

  @@index([departmentId])
  @@index([hotelId])
  @@map("employees")
}

model Task {
  id           String     @id @default(uuid()) @db.Uuid
  title        String     @db.VarChar(255)
  description  String?
  departmentId String     @map("department_id")
  assigneeId   String?    @db.Uuid @map("assignee_id")
  priority     String     @default("MEDIUM") @db.VarChar(16) // LOW | MEDIUM | HIGH | URGENT
  status       String     @default("PENDING") @db.VarChar(32) // PENDING | IN_PROGRESS | COMPLETED | CANCELLED
  dueDate      DateTime?  @db.Timestamptz(6) @map("due_date")
  completedAt  DateTime?  @db.Timestamptz(6) @map("completed_at")
  createdAt    DateTime   @default(now()) @db.Timestamptz(6) @map("created_at")
  updatedAt    DateTime   @updatedAt @db.Timestamptz(6) @map("updated_at")
  assignee     Employee?  @relation(fields: [assigneeId], references: [id])

  @@map("tasks")
}

model Schedule {
  id         String   @id @default(uuid()) @db.Uuid
  employeeId String   @db.Uuid @map("employee_id")
  date       DateTime @db.Date
  shiftStart String   @map("shift_start") // "08:00"
  shiftEnd   String   @map("shift_end") // "16:00"
  shiftType  String   @map("shift_type") // "MORNING" | "AFTERNOON" | "NIGHT"
  notes      String?
  employee   Employee @relation(fields: [employeeId], references: [id])

  @@map("schedules")
}
