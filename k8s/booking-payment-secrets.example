# Copy this file to booking-payment-secrets.env (ignored by git), replace each value,
# then create the Kubernetes Secret with the commands in services/README.md.
BOOKING_DATABASE_URL=postgres://USER:PASSWORD@POSTGRES_HOST:5432/hotel_bookings_db?sslmode=require
PAYMENT_DATABASE_URL=postgres://USER:PASSWORD@POSTGRES_HOST:5432/hotel_payments_db?sslmode=require
REDIS_URL=rediss://:PASSWORD@REDIS_HOST:6379
RABBITMQ_URL=amqps://USER:PASSWORD@RABBITMQ_HOST:5671
AUTH_SERVICE_URL=http://auth-service.hotel-platform.svc.cluster.local:8001
HOTEL_SERVICE_URL=http://operations-service.hotel-platform.svc.cluster.local:8020
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
